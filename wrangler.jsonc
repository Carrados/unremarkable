{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unremarkable",
  "compatibility_date": "2026-10-01",
  // The site is static. The Worker handles the forms at /fix/ and /start/,
  // sends www to the bare domain, and passes everything else to the static files.
  "main": "fix/worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unremarkable-fix",
      "database_id": "e033c54e-968d-4d54-93b4-fde6d64f6483"
    }
  ],
  // Phix wakes at 06:00 and midday, UK time. Cron runs on UTC, so it fires at both hours either side
  // and fix/phix.js keeps the one that is 06:00 or 12:00 in London, summer or winter.
  "triggers": { "crons": ["0 5,6,11,12 * * *"] },
  // Limits reports per sender without storing anything: the key is held in memory only.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
